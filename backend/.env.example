PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/auto_clarity

# Any long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Groq (LLM)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1

# DVLA Vehicle Enquiry API
DVLA_API_KEY=

# SerpAPI (nearby garages)
SERP_API_KEY=

# YouTube Data API (repair videos)
YOUTUBE_API_KEY=

# Optional VIN decoder
VEHICLE_DB_URL=
VEHICLE_DB_API_KEY=
