generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  diagnostics  Diagnostic[]
}

model Diagnostic {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  obdCode     String
  codeTitle   String
  vehicleReg  String?
  vehicleVin  String?
  vehicleInfo Json?
  sessionData Json
  diagnosis   Json
  severity    String
  createdAt   DateTime @default(now())

  @@index([userId])
}
